# AWS RDS PostgreSQL Configuration Example

# Option 1: Direct Connection String (Recommended for Vercel / Railway / AWS App Runner)
DATABASE_URL="postgres://postgres:your_password@your-rds-instance.c123456789.us-east-1.rds.amazonaws.com:5432/aerodrop_db"

# Option 2: Individual AWS RDS Parameters
DB_HOST="your-rds-instance.c123456789.us-east-1.rds.amazonaws.com"
DB_PORT=5432
DB_NAME="aerodrop_db"
DB_USER="postgres"
DB_PASSWORD="your_secure_password"
DB_SSL=true

# Server Port
PORT=3001
